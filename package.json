{
  "name": "@itslil/solidjs",
  "version": "0.1.1",
  "description": "Experimental Solid 2.0 compatibility runtime and in-progress file-for-file LilScript port.",
  "keywords": [
    "solid",
    "solidjs",
    "reactive",
    "signals",
    "lilscript"
  ],
  "homepage": "https://yeargun.github.io/solidlil/",
  "bugs": "https://github.com/yeargun/lil-solidjs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/lil-solidjs.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "yeargun",
  "type": "module",
  "sideEffects": [
    "./dist/compat.cjs",
    "./dist/compat.js",
    "./dist/core.cjs",
    "./dist/dom-tables.cjs",
    "./dist/dom-tables.js",
    "./dist/full.cjs",
    "./dist/full.js",
    "./dist/index.bundle.js",
    "./dist/index.cjs",
    "./dist/index.js",
    "./dist/internal/cjs/chunk-0.cjs",
    "./dist/internal/cjs/chunk-1.cjs",
    "./dist/internal/cjs/chunk-2.cjs",
    "./dist/internal/cjs/extern0-12.cjs",
    "./dist/internal/cjs/extern1-13.cjs",
    "./dist/internal/cjs/extern2-14.cjs",
    "./dist/internal/cjs/extern3-15.cjs",
    "./dist/internal/cjs/reactive-7.cjs",
    "./dist/internal/cjs/store-8.cjs",
    "./dist/internal/esm/chunk-0.js",
    "./dist/internal/esm/chunk-1.js",
    "./dist/internal/esm/chunk-2.js",
    "./dist/internal/esm/extern0-12.js",
    "./dist/internal/esm/extern1-13.js",
    "./dist/internal/esm/extern2-14.js",
    "./dist/internal/esm/extern3-15.js",
    "./dist/lil-web.cjs",
    "./dist/lil-web.js",
    "./dist/solid-api.js",
    "./dist/solidlil.global.js",
    "./dist/web-api.js",
    "./dist/web.cjs",
    "./dist/web.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/solidlil.global.js",
  "jsdelivr": "./dist/solidlil.global.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./types/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs",
      "default": "./dist/web.js"
    },
    "./full": {
      "types": "./types/full.d.ts",
      "import": "./dist/full.js",
      "require": "./dist/full.cjs",
      "default": "./dist/full.js"
    },
    "./global": "./dist/solidlil.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:apps": "node scripts/build-apps.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:jfb": "npm --prefix benchmarks/js-framework-benchmark/keyed/solid-v2 run build-prod && npm --prefix benchmarks/js-framework-benchmark/keyed/solidlil run build-prod",
    "measure:jfb": "node scripts/measure-jfb-size.mjs",
    "setup:upstream": "node scripts/setup-upstream-source.mjs",
    "audit:upstream": "node scripts/audit-upstream-port.mjs",
    "audit:upstream:strict": "node scripts/audit-upstream-port.mjs --strict",
    "compare:demo-sizes": "node scripts/compare-demo-sizes.mjs d51127a",
    "build:all": "npm run build && npm run build:apps && npm run build:jfb && npm run measure:jfb && npm run bench:perf && npm run build:site",
    "bench:perf": "node scripts/measure-perf.mjs",
    "check": "npm run test && npm run check:types && npm run check:site && npm run check:pack",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:types": "tsc -p test/types/tsconfig.json",
    "check:pack": "node scripts/check-pack.mjs",
    "test": "node --test test/node.test.mjs test/vite.test.mjs test/coverage.test.mjs test/jfb.test.mjs test/apps-e2e.test.mjs",
    "test:size": "node scripts/measure-size.mjs && node scripts/measure-runtime.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@solidjs/signals": "2.0.0-rc.0",
    "@solidjs/vite-plugin": "3.0.0-next.30",
    "@solidjs/web": "2.0.0-rc.0",
    "esbuild": "0.28.2",
    "playwright": "1.55.0",
    "solid-js": "2.0.0-rc.0",
    "terser": "5.43.1",
    "typescript": "5.9.2",
    "vite": "8.2.1"
  }
}
