import { Signal, append, createIntSignal, render } from "solidlil";

func()->void dispose = render("#app", (Element root) => {
  Signal<int> boom = createIntSignal(0);
  Element view = (
    <div class="stack">
      <h2>Error reset</h2>
      <button onClick={() => { boom.write(boom.read() + 1); }}>Trip error</button>
      <Show
        when={boom.read() == 0}
        fallback={
          <div class="card">
            <p>Error: Boom</p>
            <button onClick={() => {
              boom.write(0);
            }}>
              Reset
            </button>
          </div>
        }
      >
        <p>All clear</p>
      </Show>
    </div>
  );
  append(root, view);
});
