import {
  Context,
  Signal,
  createBoolSignal,
  createContext,
  createIntSignal,
  createRenderBind,
  createRenderEffect,
  createRoot,
  createSelector,
  createSignal,
  createStringSignal,
  disposeRoot,
  enablePendingThrows,
  flush,
  onCleanup,
  popRoot,
  pushRoot,
  runRoot,
  provideContext,
  selectorMatch,
  signalGet,
  signalSet,
  untrack
} from "./reactive";
import {
  Document,
  Element,
  Math,
  Window,
  document,
  window
} from "./host";

export {
  createIntSignal,
  createRenderEffect,
  createRoot,
  createSelector,
  createSignal,
  createStringSignal,
  flush,
  onCleanup,
  selectorMatch,
  signalGet,
  signalSet,
  untrack
};

void emptyDispose() {}

bool hydrating = false;
Element? hydrateCursor = null;
int nextRevealId = 0;

export class RevealSlot {
  int ownerId;
  int index;
  bool ready;

  init(int ownerId, int index) {
    this.ownerId = ownerId;
    this.index = index;
    this.ready = false;
  }
}

class RevealController {
  int id;
  RevealSlot[] slots;
  string order;
  bool collapsed;
  Signal<int> version;

  init(string order, bool collapsed) {
    this.id = nextRevealId;
    nextRevealId += 1;
    this.slots = [];
    this.order = order;
    this.collapsed = collapsed;
    this.version = createIntSignal(0);
  }

  RevealSlot addSlot() {
    RevealSlot slot = new RevealSlot(this.id, this.slots.length);
    this.slots.push(slot);
    return slot;
  }

  bool allowed(RevealSlot slot) {
    this.version.read();
    if (this.order == "natural") {
      return true;
    }
    if (this.order == "together") {
      for (int index = 0; index < this.slots.length; index++) {
        if (!this.slots[index].ready) {
          return false;
        }
      }
      return true;
    }
    for (int index = 0; index < this.slots.length; index++) {
      if (this.slots[index].index == slot.index) {
        return true;
      }
      if (!this.slots[index].ready) {
        return false;
      }
    }
    return true;
  }

  bool showFallback(RevealSlot slot) {
    if (!this.collapsed || this.order != "sequential") {
      return true;
    }
    for (int index = 0; index < this.slots.length; index++) {
      if (this.slots[index].index == slot.index) {
        return true;
      }
      if (!this.slots[index].ready) {
        return false;
      }
    }
    return true;
  }

  void setReady(RevealSlot slot, bool ready) {
    if (slot.ready == ready) {
      return;
    }
    slot.ready = ready;
    Signal<int> version = this.version;
    version.write(version.peek() + 1);
  }
}

RevealController[] revealControllers = [];
RevealController[] revealStack = [];

RevealController revealOwner(RevealSlot slot) {
  return revealControllers[slot.ownerId];
}

export bool isHydrating() {
  return hydrating;
}

export RevealSlot? openRevealSlot() {
  if (revealStack.length == 0) {
    return null;
  }
  return revealStack[revealStack.length - 1].addSlot();
}

export bool revealAllowed(RevealSlot slot) {
  return revealOwner(slot).allowed(slot);
}

export bool revealShowFallback(RevealSlot slot) {
  return revealOwner(slot).showFallback(slot);
}

export void revealSetReady(RevealSlot slot, bool ready) {
  revealOwner(slot).setReady(slot, ready);
}

void placeMarker(Element parent, Element marker) {
  if (!hydrating) {
    parent.appendChild(marker);
  }
}

void attach(Element parent, Element child, Element? before) {
  Element? existing = child.parentNode;
  if (hydrating && existing == parent) {
    return;
  }
  parent.insertBefore(child, before);
}

void wipeAfterMarker(Element marker) {
  Element? host = marker.parentNode;
  if (host == null) {
    return;
  }
  Element? cursor = marker.nextSibling;
  while (cursor != null) {
    Element current = cursor;
    cursor = current.nextSibling;
    host.removeChild(current);
  }
}

void appendNodes(Element parent, Element marker, Element[] nodes) {
  if (nodes.length == 0) {
    return;
  }
  if (hydrating) {
    bool owned = true;
    for (int index = 0; index < nodes.length; index++) {
      Element? existing = nodes[index].parentNode;
      if (existing != parent) {
        owned = false;
        break;
      }
    }
    if (owned) {
      return;
    }
  }
  Element fragment = document.createDocumentFragment();
  for (int index = 0; index < nodes.length; index++) {
    fragment.appendChild(nodes[index]);
  }
  Element? after = marker.nextSibling;
  parent.insertBefore(fragment, after);
}

export Element prepareTemplate(string html) {
  Element template = document.createElement("template");
  template.innerHTML = html;
  Element fragment = template.content;
  Element? node = fragment.firstChild;
  if (node == null) {
    return document.createElement("div");
  }
  return node;
}

export Element cloneTemplate(Element node) {
  if (hydrating) {
    Element? cursor = hydrateCursor;
    if (cursor != null) {
      Element claimed = cursor;
      hydrateCursor = claimed.nextSibling;
      return claimed;
    }
  }
  return node.cloneNode(true);
}

export Element element(string tag) {
  return document.createElement(tag);
}

export Element svgElement(string tag) {
  return document.createElementNS("http://www.w3.org/2000/svg", tag);
}

export Element text(string value) {
  return document.createTextNode(value);
}

export Element comment() {
  return document.createComment("");
}

export Element firstChild(Element node) {
  Element? child = node.firstChild;
  if (child == null) {
    return node;
  }
  return child;
}

export Element nextSibling(Element node) {
  Element? sibling = node.nextSibling;
  if (sibling == null) {
    return node;
  }
  return sibling;
}

export void append(Element parent, Element child) {
  Element? existing = child.parentNode;
  if (hydrating && existing == parent) {
    return;
  }
  parent.appendChild(child);
}

export void removeNode(Element node) {
  Element? parent = node.parentNode;
  if (parent != null) {
    parent.removeChild(node);
  }
}

export void insertBefore(Element parent, Element child, Element? before) {
  parent.insertBefore(child, before);
}

export void clear(Element parent) {
  Element? child = parent.firstChild;
  while (child != null) {
    Element current = child;
    child = current.nextSibling;
    parent.removeChild(current);
  }
}

export void setText(Element node, string value) {
  if (node.nodeType == 3) {
    if (node.textContent != value) {
      node.textContent = value;
    }
    return;
  }
  Element? child = node.firstChild;
  if (child != null && child.nodeType == 3 && child.nextSibling == null) {
    if (child.textContent != value) {
      child.textContent = value;
    }
    return;
  }
  if (node.textContent != value) {
    node.textContent = value;
  }
}

export void bindText(Element node, func()->string compute) {
  createRenderBind(compute, (string value) => setText(node, value));
}

export void bindTextData(Element node, Signal<string> source) {
  node.data = source.committed;
  Signal<string> signal = source;
  Element target = node;
  signal.watch(() => {
    target.data = signal.committed;
  });
}

export void bindAttribute(Element node, string name, func()->string compute) {
  createRenderBind(compute, (string value) => node.setAttribute(name, value));
}

export void bindClass(Element node, string name, func()->bool compute) {
  createRenderBind(compute, (bool value) => node.classList.toggle(name, value));
}

export void bindHidden(Element node, func()->bool compute) {
  createRenderBind(compute, (bool value) => {
    node.hidden = value;
  });
}

export void bindValue(Element node, func()->string compute) {
  createRenderBind(compute, (string value) => {
    if (node.value != value) {
      node.value = value;
    }
  });
}

export void bindChecked(Element node, func()->bool compute) {
  createRenderBind(compute, (bool value) => {
    node.checked = value;
  });
}

export void bindStyle(Element node, string name, func()->string compute) {
  createRenderBind(compute, (string value) => node.style.setProperty(name, value));
}

export void onClick(Element node, func()->void handler) {
  func()->void wrapped = () => {
    handler();
    flush();
  };
  node.addEventListener("click", wrapped);
  onCleanup(() => node.removeEventListener("click", wrapped));
}

export void onInput(Element node, func()->void handler) {
  func()->void wrapped = () => {
    handler();
    flush();
  };
  node.addEventListener("input", wrapped);
  onCleanup(() => node.removeEventListener("input", wrapped));
}

export void onChange(Element node, func()->void handler) {
  node.addEventListener("change", handler);
  onCleanup(() => node.removeEventListener("change", handler));
}

export func()->void render(string selector, func(Element)->void app) {
  Element? root = document.querySelector(selector);
  if (root == null) {
    throw "solidlil: render root not found";
  }
  Element mount = root;
  return createRoot((func()->void dispose) => {
    app(mount);
    onCleanup(() => clear(mount));
    return dispose;
  });
}

export func()->void renderNode(Element mount, func(Element)->void app) {
  return createRoot((func()->void dispose) => {
    app(mount);
    onCleanup(() => clear(mount));
    return dispose;
  });
}

export func()->void hydrate(string selector, func(Element)->void app) {
  Element? root = document.querySelector(selector);
  if (root == null) {
    throw "solidlil: hydrate root not found";
  }
  return hydrateNode(root, app);
}

export func()->void hydrateNode(Element mount, func(Element)->void app) {
  bool previous = hydrating;
  Element? previousCursor = hydrateCursor;
  hydrating = true;
  hydrateCursor = mount.firstChild;
  func()->void dispose = createRoot((func()->void dispose) => {
    app(mount);
    onCleanup(() => clear(mount));
    return dispose;
  });
  hydrating = previous;
  hydrateCursor = previousCursor;
  return dispose;
}

export void reveal(Element parent, func()->void children) {
  revealOrdered(parent, children, "sequential", false);
}

export void revealOrdered(Element parent, func()->void children, string order, bool collapsed) {
  RevealController controller = new RevealController(order, collapsed);
  revealControllers.push(controller);
  revealStack.push(controller);
  try {
    children();
  } finally {
    revealStack.pop();
  }
}

class Disposer {
  func()->void run;

  init(func()->void run) {
    this.run = run;
  }

  void dispose() {
    func()->void run = this.run;
    run();
  }
}

export void show(
  Element parent,
  func()->bool when,
  func()->Element children,
  func()->Element fallback
) {
  Element marker = comment();
  placeMarker(parent, marker);
  Element? current = null;
  Disposer? currentDispose = null;
  createRenderEffect(() => {
    bool visible = when();
    Disposer? previousDispose = currentDispose;
    if (previousDispose != null) {
      previousDispose.dispose();
    }
    currentDispose = new Disposer(createRoot((func()->void dispose) => {
      Element next = comment();
      if (visible) {
        next = children();
      } else {
        next = fallback();
      }
      Element? after = marker.nextSibling;
      attach(parent, next, after);
      current = next;
      return dispose;
    }));
  });
  onCleanup(() => {
    Disposer? dispose = currentDispose;
    if (dispose != null) {
      dispose.dispose();
    }
    if (current != null) {
      removeNode(current);
    }
    removeNode(marker);
  });
}

export void switchIndex(
  Element parent,
  func()->int selected,
  (func()->Element)[] branches,
  func()->Element fallback
) {
  Element marker = comment();
  placeMarker(parent, marker);
  Element? current = null;
  createRenderEffect(() => {
    int index = selected();
    Element next = untrack(() => {
      if (index >= 0 && index < branches.length) {
        func()->Element branch = branches[index];
        return branch();
      }
      return fallback();
    });
    if (current != null) {
      removeNode(current);
    }
    Element? after = marker.nextSibling;
    attach(parent, next, after);
    current = next;
  });
  onCleanup(() => {
    if (current != null) {
      removeNode(current);
    }
    removeNode(marker);
  });
}

void reorderNodes(Element parent, Element marker, Element[] previous, Element[] next) {
  int aStart = 0;
  int bStart = 0;
  int aEnd = previous.length;
  int bEnd = next.length;
  while (true) {
    if (aStart >= aEnd) {
      break;
    }
    if (bStart >= bEnd) {
      break;
    }
    if (previous[aStart] != next[bStart]) {
      break;
    }
    aStart += 1;
    bStart += 1;
  }
  while (true) {
    if (aEnd <= aStart) {
      break;
    }
    if (bEnd <= bStart) {
      break;
    }
    if (previous[aEnd - 1] != next[bEnd - 1]) {
      break;
    }
    aEnd -= 1;
    bEnd -= 1;
  }
  int remaining = aEnd - aStart;
  bool swappedEnds = false;
  if (remaining == bEnd - bStart) {
    if (remaining >= 2) {
      if (previous[aStart] == next[bEnd - 1]) {
        if (previous[aEnd - 1] == next[bStart]) {
          swappedEnds = true;
        }
      }
    }
  }
  if (swappedEnds) {
    bool middleSame = true;
    int offset = 1;
    while (aStart + offset < aEnd - 1) {
      if (previous[aStart + offset] != next[bStart + offset]) {
        middleSame = false;
        break;
      }
      offset += 1;
    }
    if (middleSame) {
      Element first = previous[aStart];
      Element last = previous[aEnd - 1];
      parent.insertBefore(last, first);
      Element? afterTail = null;
      if (bEnd < next.length) {
        afterTail = next[bEnd];
      }
      parent.insertBefore(first, afterTail);
      return;
    }
  }
  Element? cursor = marker.nextSibling;
  if (bStart > 0) {
    cursor = next[bStart - 1].nextSibling;
  }
  int index = bStart;
  while (index < bEnd) {
    Element node = next[index];
    if (node != cursor) {
      parent.insertBefore(node, cursor);
    }
    cursor = node.nextSibling;
    index += 1;
  }
}

Element[] liveSiblings(Element marker) {
  Element[] nodes = [];
  Element? cursor = marker.nextSibling;
  while (cursor != null) {
    nodes.push(cursor);
    cursor = cursor.nextSibling;
  }
  return nodes;
}

class KeyedRow<T> {
  T item;
  int key;
  Element node;
  Signal<int> index;
  int ownerId;

  init(T item, int key, Element node, Signal<int> index, int ownerId) {
    this.item = item;
    this.key = key;
    this.node = node;
    this.index = index;
    this.ownerId = ownerId;
  }

  void drop() {
    int ownerId = this.ownerId;
    if (ownerId < 0) {
      return;
    }
    this.ownerId = -1;
    disposeRoot(ownerId);
  }

  void release() {
    this.drop();
    removeNode(this.node);
  }
}

class KeyedTable<T> {
  Map<int, KeyedRow<T> > rows;
  KeyedRow<T>[] order;

  init() {
    this.rows = new Map<int, KeyedRow<T> >();
    this.order = [];
  }

  void put(int key, KeyedRow<T> row) {
    this.rows.set(key, row);
    this.order.push(row);
  }

  KeyedRow<T>? take(int key) {
    KeyedRow<T>? row = this.rows.get(key);
    if (row == null) {
      return null;
    }
    this.rows.delete(key);
    return row;
  }

  void disposeRemaining() {
    for (int index = 0; index < this.order.length; index++) {
      KeyedRow<T> leftover = this.order[index];
      if (this.rows.has(leftover.key)) {
        leftover.release();
        this.rows.delete(leftover.key);
      }
    }
  }

  void disposeAll() {
    for (int index = 0; index < this.order.length; index++) {
      this.order[index].release();
    }
  }

  void dropAll() {
    for (int index = 0; index < this.order.length; index++) {
      this.order[index].drop();
    }
  }
}

class TableRef<T> {
  KeyedTable<T> current;
  Element built;

  init() {
    this.current = new KeyedTable();
    this.built = comment();
  }
}

export void keyedEach<T>(
  Element parent,
  func()->T[] items,
  func(T)->int keyOf,
  func(T, Signal<int>)->Element createRow
) {
  keyedEachTracked(parent, items, keyOf, createRow, true);
}

export void keyedEachPlain<T>(
  Element parent,
  func()->T[] items,
  func(T)->int keyOf,
  func(T)->Element createRow
) {
  keyedEachTracked(parent, items, keyOf, (T item, Signal<int> index) => createRow(item), false);
}

void keyedEachTracked<T>(
  Element parent,
  func()->T[] items,
  func(T)->int keyOf,
  func(T, Signal<int>)->Element createRow,
  bool trackIndex
) {
  Element marker = comment();
  placeMarker(parent, marker);
  TableRef<T> holder = new TableRef();
  Signal<int> unusedIndex = createIntSignal(0);
  func(T[])->void reconcile = (T[] nextItems) => {
    KeyedTable<T> previous = holder.current;
    KeyedTable<T> nextTable = new KeyedTable();
    if (previous.order.length == 0) {
      if (nextItems.length == 0) {
        holder.current = nextTable;
        return;
      }
      Element fragment = document.createDocumentFragment();
      for (int index = 0; index < nextItems.length; index++) {
        T item = nextItems[index];
        int key = keyOf(item);
        Signal<int> indexSignal = unusedIndex;
        if (trackIndex) {
          indexSignal = createIntSignal(index);
        }
        int ownerId = pushRoot();
        holder.built = createRow(item, indexSignal);
        popRoot();
        nextTable.put(key, new KeyedRow(item, key, holder.built, indexSignal, ownerId));
        fragment.appendChild(holder.built);
      }
      parent.insertBefore(fragment, marker.nextSibling);
      holder.current = nextTable;
      return;
    }
    int reused = 0;
    for (int index = 0; index < nextItems.length; index++) {
      T item = nextItems[index];
      int key = keyOf(item);
      KeyedRow<T>? matched = null;
      if (previous.order.length > 0) {
        matched = previous.take(key);
      }
      if (matched != null) {
        matched.item = item;
        if (trackIndex) {
          matched.index.write(index);
        }
        nextTable.put(key, matched);
        reused += 1;
      } else {
        Signal<int> indexSignal = unusedIndex;
        if (trackIndex) {
          indexSignal = createIntSignal(index);
        }
        int ownerId = pushRoot();
        holder.built = createRow(item, indexSignal);
        popRoot();
        nextTable.put(key, new KeyedRow(item, key, holder.built, indexSignal, ownerId));
      }
    }
    if (reused == 0) {
      wipeAfterMarker(marker);
      previous.dropAll();
      Element fragment = document.createDocumentFragment();
      for (int index = 0; index < nextTable.order.length; index++) {
        fragment.appendChild(nextTable.order[index].node);
      }
      parent.insertBefore(fragment, marker.nextSibling);
      holder.current = nextTable;
      return;
    }
    Element[] nextNodes = [];
    for (int index = 0; index < nextTable.order.length; index++) {
      nextNodes.push(nextTable.order[index].node);
    }
    if (
      reused == previous.order.length &&
      nextNodes.length > reused
    ) {
      bool prefix = true;
      for (int cursor = 0; cursor < reused; cursor++) {
        if (previous.order[cursor].node != nextTable.order[cursor].node) {
          prefix = false;
          break;
        }
      }
      if (prefix) {
        Element[] tail = [];
        for (int cursor = reused; cursor < nextNodes.length; cursor++) {
          tail.push(nextNodes[cursor]);
        }
        Element last = nextNodes[reused - 1];
        Element fragment = document.createDocumentFragment();
        for (int cursor = 0; cursor < tail.length; cursor++) {
          fragment.appendChild(tail[cursor]);
        }
        parent.insertBefore(fragment, last.nextSibling);
        holder.current = nextTable;
        return;
      }
    }
    Element[] previousNodes = [];
    for (int index = 0; index < previous.order.length; index++) {
      KeyedRow<T> row = previous.order[index];
      if (!previous.rows.has(row.key)) {
        previousNodes.push(row.node);
      }
    }
    previous.disposeRemaining();
    if (previousNodes.length == 0) {
      appendNodes(parent, marker, nextNodes);
    } else {
      reorderNodes(parent, marker, previousNodes, nextNodes);
    }
    holder.current = nextTable;
  };
  createRenderEffect(() => {
    T[] nextItems = items();
    untrack(() => reconcile(nextItems));
  });
  onCleanup(() => {
    holder.current.disposeAll();
    removeNode(marker);
  });
}

class IdentityRow<T> {
  T item;
  Element node;
  Signal<int> index;
  func()->void dispose;

  init(T item, Element node, Signal<int> index, func()->void dispose) {
    this.item = item;
    this.node = node;
    this.index = index;
    this.dispose = dispose;
  }

  void release() {
    func()->void dispose = this.dispose;
    this.dispose = emptyDispose;
    dispose();
    removeNode(this.node);
  }
}

class IdentityTable<T> {
  IdentityRow<T>[] order;

  init() {
    this.order = [];
  }
}

class IdentityRef<T> {
  IdentityTable<T> current;

  init() {
    this.current = new IdentityTable();
  }
}

export void identityEach<T>(
  Element parent,
  func()->T[] items,
  func(T, Signal<int>)->Element createRow
) {
  Element marker = comment();
  placeMarker(parent, marker);
  IdentityRef<T> holder = new IdentityRef();
  func(T[])->void reconcile = (T[] nextItems) => {
    IdentityRow<T>[] previous = holder.current.order;
    IdentityRow<T>[] nextRows = [];
    for (int index = 0; index < nextItems.length; index++) {
      T item = nextItems[index];
      IdentityRow<T>? matched = null;
      for (int cursor = 0; cursor < previous.length; cursor++) {
        IdentityRow<T> candidate = previous[cursor];
        if (candidate.item == item) {
          matched = candidate;
          int last = previous.length - 1;
          previous[cursor] = previous[last];
          previous.pop();
          break;
        }
      }
      if (matched != null) {
        matched.index.write(index);
        nextRows.push(matched);
      } else {
        createRoot((func()->void innerDispose) => {
          Signal<int> indexSignal = createIntSignal(index);
          Element node = createRow(item, indexSignal);
          nextRows.push(new IdentityRow(item, node, indexSignal, innerDispose));
          return innerDispose;
        });
      }
    }
    while (previous.length > 0) {
      IdentityRow<T> leftover = previous[previous.length - 1];
      previous.pop();
      leftover.release();
    }
    Element[] nextNodes = [];
    for (int index = 0; index < nextRows.length; index++) {
      nextNodes.push(nextRows[index].node);
    }
    reorderNodes(parent, marker, liveSiblings(marker), nextNodes);
    holder.current.order = nextRows;
  };
  createRenderEffect(() => {
    T[] nextItems = items();
    untrack(() => reconcile(nextItems));
  });
  onCleanup(() => {
    IdentityRow<T>[] current = holder.current.order;
    while (current.length > 0) {
      IdentityRow<T> leftover = current[current.length - 1];
      current.pop();
      leftover.release();
    }
    removeNode(marker);
  });
}

export void indexEach<T>(
  Element parent,
  func()->T[] items,
  func(Signal<T>, int)->Element createRow
) {
  Element marker = comment();
  placeMarker(parent, marker);
  Signal<T>[] itemSignals = [];
  Element[] nodes = [];
  (func()->void)[] disposers = [];

  createRenderEffect(() => {
    T[] nextItems = items();
    while (itemSignals.length > nextItems.length) {
      int last = itemSignals.length - 1;
      itemSignals.pop();
      func()->void dispose = disposers[last];
      disposers.pop();
      Element node = nodes[last];
      nodes.pop();
      dispose();
      removeNode(node);
    }
    for (int index = 0; index < nextItems.length; index++) {
      T item = nextItems[index];
      if (index < itemSignals.length) {
        itemSignals[index].write(item);
      } else {
        Signal<T> itemSignal = createSignal(item, (T previous, T next) => previous == next);
        createRoot((func()->void innerDispose) => {
          Element node = createRow(itemSignal, index);
          nodes.push(node);
          parent.insertBefore(node, null);
          disposers.push(innerDispose);
          return innerDispose;
        });
        itemSignals.push(itemSignal);
      }
    }
  });
  onCleanup(() => {
    while (disposers.length > 0) {
      int last = disposers.length - 1;
      func()->void dispose = disposers[last];
      disposers.pop();
      Element node = nodes[last];
      nodes.pop();
      itemSignals.pop();
      dispose();
      removeNode(node);
    }
    removeNode(marker);
  });
}

export void repeat(
  Element parent,
  func()->int count,
  func(int)->Element createRow
) {
  Element marker = comment();
  placeMarker(parent, marker);
  Element[] nodes = [];
  (func()->void)[] disposers = [];
  createRenderEffect(() => {
    int nextCount = count();
    if (nextCount < 0) {
      nextCount = 0;
    }
    while (nodes.length > nextCount) {
      int last = nodes.length - 1;
      func()->void dispose = disposers[last];
      disposers.pop();
      Element node = nodes[last];
      nodes.pop();
      dispose();
      removeNode(node);
    }
    while (nodes.length < nextCount) {
      int index = nodes.length;
      createRoot((func()->void innerDispose) => {
        Element node = createRow(index);
        nodes.push(node);
        parent.insertBefore(node, null);
        disposers.push(innerDispose);
        return innerDispose;
      });
    }
  });
  onCleanup(() => {
    while (disposers.length > 0) {
      int last = disposers.length - 1;
      func()->void dispose = disposers[last];
      disposers.pop();
      Element node = nodes[last];
      nodes.pop();
      dispose();
      removeNode(node);
    }
    removeNode(marker);
  });
}

export void portal(Element target, func()->Element children) {
  Element node = children();
  target.appendChild(node);
  onCleanup(() => removeNode(node));
}

export void loading(
  Element parent,
  func()->void ready,
  func()->Element fallback
) {
  Element marker = comment();
  placeMarker(parent, marker);
  Element? current = null;
  RevealSlot? slot = openRevealSlot();
  createRenderEffect(() => {
    if (slot != null) {
      RevealSlot currentSlot = slot;
      if (!revealAllowed(currentSlot)) {
        if (revealShowFallback(currentSlot)) {
          Element held = untrack(fallback);
          if (current != null) {
            removeNode(current);
          }
          attach(parent, held, marker.nextSibling);
          current = held;
        }
        return;
      }
    }
    enablePendingThrows(true);
    try {
      if (current != null) {
        removeNode(current);
        current = null;
      }
      ready();
      if (slot != null) {
        revealSetReady(slot, true);
      }
    } catch (auto error) {
      if (slot != null) {
        revealSetReady(slot, false);
      }
      Element next = untrack(fallback);
      if (current != null) {
        removeNode(current);
      }
      attach(parent, next, marker.nextSibling);
      current = next;
    } finally {
      enablePendingThrows(false);
    }
  });
  onCleanup(() => {
    if (current != null) {
      removeNode(current);
    }
    removeNode(marker);
  });
}

Context<func(string)->void> errorContext = createContext((string message) => {
  throw message;
});

export void errored(
  Element parent,
  func()->void children,
  func(string, func()->void)->Element fallback
) {
  Element marker = comment();
  placeMarker(parent, marker);
  Element? current = null;
  Signal<string> message = createStringSignal("");
  Signal<bool> failed = createBoolSignal(false);

  func()->void reset = () => {
    message.write("");
    failed.write(false);
  };

  createRenderEffect(() => {
    if (failed.read()) {
      string text = message.read();
      Element next = untrack(() => fallback(text, reset));
      if (current != null) {
        removeNode(current);
      }
      Element? after = marker.nextSibling;
      attach(parent, next, after);
      current = next;
      return;
    }
    provideContext(errorContext, (string error) => {
      message.write(error);
      failed.write(true);
    }, () => {
      try {
        children();
      } catch (auto error) {
        if (error is string) {
          message.write(error);
        } else {
          message.write("error");
        }
        failed.write(true);
      }
      return 0;
    });
  });
  onCleanup(() => {
    if (current != null) {
      removeNode(current);
    }
    removeNode(marker);
  });
}

export int randomIndex(int maximum) {
  if (maximum <= 0) {
    return 0;
  }
  return (Math.random() * maximum).round().toInt() % maximum;
}

export int delay(func()->void callback, int ms) {
  return window.setTimeout(callback, ms);
}

export void clearDelay(int id) {
  window.clearTimeout(id);
}

export int every(func()->void callback, int ms) {
  return window.setInterval(callback, ms);
}

export void stopEvery(int id) {
  window.clearInterval(id);
}

export Document hostDocument() {
  return document;
}

export Window hostWindow() {
  return window;
}
