/** Client-side no-op retained for the isomorphic server API surface. */
export void ssrHandleError() {}

/** Client-side server-scope identity wrapper. */
export func()->T ssrScope<T>(func()->T fn) {
  return fn;
}

/** Executes directly because client components have no server scope. */
export T runInServerComponentScope<T>(func()->T fn) {
  return fn();
}

export int creationStamp() {
  return 0;
}

export bool inServerComponentScope() {
  return false;
}

/** Client values never carry server projection traces. */
export JsValue getProjectionTrace(JsValue _value) {
  return JS.undefined();
}

export JsValue DEV = if (IS_DEV) { signalsDEV } else { JS.undefined() };

if (IS_DEV && globalThis.truthy()) {
  if (!globalThis["Solid$$"].truthy()) globalThis["Solid$$"] = true;
  else {
    JS.invoke(
      console,
      "warn",
      "You appear to have multiple instances of Solid. This can lead to unexpected behavior."
    );
  }
}
