JsValue undefinedValue() {
  return JS.undefined();
}

JsValue call0(JsValue fn) {
  return JS.call(fn, undefinedValue());
}

JsValue call1(JsValue fn, JsValue value) {
  return JS.call(fn, undefinedValue(), value);
}

JsValue call2(JsValue fn, JsValue first, JsValue second) {
  return JS.call(fn, undefinedValue(), first, second);
}

JsValue call3(JsValue fn, JsValue first, JsValue second, JsValue third) {
  return JS.call(fn, undefinedValue(), first, second, third);
}

JsValue memo(JsValue compute, JsValue options) {
  return call2(createMemo, compute, options);
}

JsValue untracked(JsValue compute, string label) {
  if (IS_DEV) return call2(untrack, compute, label);
  return call1(untrack, compute);
}

string narrowedError(string name) {
  if (IS_DEV) {
    return "Attempting to access a stale value from <" + name + "> that could possibly be undefined. This may occur because you are reading the accessor returned from the component at a time where it has already been unmounted. We recommend cleaning up any stale timers or async, or reading from the initial condition.";
  }
  return "Stale read from <" + name + ">.";
}

