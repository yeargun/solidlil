export JsValue registerDelegatedContainer(JsValue container) {
  JsValue owner = arguments[1];
  if (JS.isUndefined(owner)) owner = container;
  if (!container.truthy() || !owner.truthy()) return JS.undefined();
  JsValue? existing = delegatedContainers.get(container);
  JsValue state = JS.undefined();
  if (existing == null) {
    state = JS.object(
      "owners", JS.construct(Map),
      "handlers", JS.construct(Map)
