export JsValue getDelegatedRoot(JsValue node) {
  while (node.truthy()) {
    JsValue? found = delegatedContainers.get(node);
    if (found != null && found["roots"].truthy()) return node;
    JsValue next = node["_$host"];
    if (!next.truthy()) next = node["parentNode"];
    if (!next.truthy()) next = node["host"];
    node = next;
  }
  return JS.undefined();
}

JsValue findOwner(JsValue target, JsValue state) {
  JsValue node = target;
  int distance = 0;
  while (node.truthy()) {
    if (JS.invoke(state["owners"], "has", node).truthy()) {
      return JS.object("owner", node, "distance", distance);
    }
    distance += 1;
    JsValue next = node["_$host"];
    if (!next.truthy()) next = node["parentNode"];
    if (!next.truthy()) next = node["host"];
    node = next;
  }
  return JS.undefined();
}

export void setProperty(JsValue node, string name, JsValue value) {
  if (isHydrating(node)) return;
  node[name] = value;
