export JsValue render(JsValue code, JsValue element, JsValue initial) {
  JsValue options = arguments[3];
  if (JS.isUndefined(options)) options = JS.object();
  if (DEV && !element.truthy()) {
    throw JS.construct(
      Error,
      "The `element` passed to `render(..., element)` doesn't exist. Make sure `element` exists in the document."
    );
  }
  JsValue box = JS.object("disposer", JS.undefined());
  registerDelegatedRoot(element);
  try {
    JS.call(
      root,
      JS.undefined(),
      JS.method1((JsValue _self, JsValue dispose) => {
        box["disposer"] = dispose;
        if (same(element, document)) {
          JsValue tree = call0(code);
          effect(
            JS.method0((JsValue _compute) => JS.call(flatten, JS.undefined(), tree)),
            JS.method1((JsValue _apply, JsValue _value) => JS.undefined())
          );
        } else {
          JsValue tree = call0(code);
          JsValue first = element["firstChild"];
          JsValue marker = JS.undefined();
          if (first.truthy()) marker = null;
          JS.call(
            JS.assume(insert),
            JS.undefined(),
            element,
            JS.method0((JsValue _tree) => tree),
            marker,
            initial,
            options["insertOptions"]
          );
        }
        return JS.undefined();
      }),
      JS.object("id", options["renderId"])
    );
  } catch (JsValue error) {
    JsValue disposer = box["disposer"];
    if (disposer.truthy()) call0(disposer);
    unregisterDelegatedRoot(element);
    throw error;
  }
  return JS.method0((JsValue _self) => {
    call0(box["disposer"]);
    unregisterDelegatedRoot(element);
    element["textContent"] = "";
    return JS.undefined();
  });
}

JsValue createTemplateNode(string html, bool bypassGuard, int flag) {
  if (DEV && isHydrating(JS.undefined()) && !bypassGuard) {
    throw JS.construct(
      Error,
      "Failed attempt to create new DOM elements during hydration. Check that the libraries you are using support hydration."
    );
  }
  JsValue templateNode = JS.invoke(document, "createElement", "template");
  templateNode["innerHTML"] = html;
  if (flag == 2) return templateNode["content"]["firstChild"]["firstChild"];
  return templateNode["content"]["firstChild"];
}

export JsValue template(string html, JsValue flag) {
  JsValue state = JS.object("node", JS.undefined());
  int flagNumber = 0;
  if (!JS.isUndefined(flag)) flagNumber = JS.number(flag).toInt();
  JsValue factory = JS.method1((JsValue _self, JsValue bypassValue) => {
    JsValue node = state["node"];
    if (JS.isUndefined(node)) {
