    JS.invoke(node, "removeAttributeNS", namespace, localName);
  } else {
    JsValue normalized = value;
    if (same(value, true)) normalized = "";
    JS.invoke(node, "setAttributeNS", namespace, name, normalized);
  }
}

JsValue classListToObject(JsValue classList) {
  if (classList.isArray()) {
    JsValue result = JS.object();
    flattenClassList(classList, result);
    classList = result;
  }
  if (!JS.isNullish(classList) && JS.typeOf(classList) == "object") {
    JsValue result = JS.object();
    JsValue keys = JS.invoke(Object, "keys", classList);
    for (int index = 0; index < lengthOf(keys); index++) {
      string key = JS.assume(keys[index]);
      if (!classList[key].truthy()) continue;
      JsValue classNames = JS.invoke(key.trim(), "split", JS.assume(new Regex("\\s+")));
      for (int nameIndex = 0; nameIndex < lengthOf(classNames); nameIndex++) {
        string name = JS.assume(classNames[nameIndex]);
        if (name != "") result[name] = true;
      }
    }
    return result;
  }
  return classList;
}

void flattenClassList(JsValue list, JsValue result) {
  for (int index = 0; index < lengthOf(list); index++) {
    JsValue item = list[index];
    if (item.isArray()) flattenClassList(item, result);
    else if (!JS.isNullish(item) && JS.typeOf(item) == "object") JS.invoke(Object, "assign", result, item);
    else if (item.truthy() || same(item, 0)) result[item] = true;
  }
