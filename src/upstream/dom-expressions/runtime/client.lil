  JsValue count = JS.invoke(state["owners"], "get", owner);
  JsValue nextCount = 1;
  if (count.truthy()) nextCount = JS.number(count) + 1;
  JS.invoke(state["owners"], "set", owner, nextCount);
  for (int index = 0; index < delegatedEventList.length; index++) {
    attachDelegatedEvent(delegatedEventList[index], container, state);
  }
  return state;
}

export void unregisterDelegatedContainer(JsValue container) {
  JsValue owner = arguments[1];
  if (JS.isUndefined(owner)) owner = container;
  JsValue? found = delegatedContainers.get(container);
  if (found == null) return;
  JsValue state = found;
  JsValue count = JS.invoke(state["owners"], "get", owner);
  if (JS.number(count) > 1) JS.invoke(state["owners"], "set", owner, JS.number(count) - 1);
  else JS.invoke(state["owners"], "delete", owner);
