export void setAttribute(JsValue node, string name, JsValue value) {
  if (isHydrating(node)) return;
  if (JS.isNullish(value) || same(value, false)) JS.invoke(node, "removeAttribute", name);
  else {
    JsValue normalized = value;
    if (same(value, true)) normalized = "";
    JS.invoke(node, "setAttribute", name, normalized);
  }
  if (!JS.isNullish(claimHandlers) && (name == "href" || name == "action")) claimElement(node);
}

export void setAttributeNS(JsValue node, string namespace, string name, JsValue value) {
  if (isHydrating(node)) return;
  if (JS.isNullish(value) || same(value, false)) {
    string localName = name;
    if (name.indexOf(":") > -1) {
      string[] parts = name.split(":");
      localName = parts[parts.length - 1];
