    string source = html;
    if (flagNumber == 2) source = JS.string(JS.invoke(html, "replace", new Regex("^<[^>]+>"), ""));
    factory["_html"] = source;
  }
  return factory;
}

export void delegateEvents(string[] eventNames) {
  for (int index = 0; index < eventNames.length; index++) {
    string name = eventNames[index];
    if (delegatedEvents.has(name)) continue;
    delegatedEvents.add(name);
    delegatedEventList.push(name);
    for (int containerIndex = 0; containerIndex < delegatedContainerList.length; containerIndex++) {
      JsValue container = delegatedContainerList[containerIndex];
      JsValue? state = delegatedContainers.get(container);
      if (state != null) attachDelegatedEvent(name, container, state);
    }
  }
}

export void registerDelegatedRoot(JsValue delegatedRoot) {
  JsValue state = registerDelegatedContainer(delegatedRoot);
  if (!JS.isUndefined(state)) {
    JsValue roots = state["roots"];
    if (roots.truthy()) state["roots"] = JS.number(roots) + 1;
    else state["roots"] = 1;
  }
}

export void unregisterDelegatedRoot(JsValue delegatedRoot) {
  JsValue? stateValue = delegatedContainers.get(delegatedRoot);
  if (stateValue != null) {
    JsValue roots = stateValue["roots"];
    if (JS.number(roots) > 1) stateValue["roots"] = JS.number(roots) - 1;
    else JS.invoke(Reflect, "deleteProperty", stateValue, "roots");
  }
  unregisterDelegatedContainer(delegatedRoot);
