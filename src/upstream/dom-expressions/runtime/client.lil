void attachDelegatedEvent(string name, JsValue container, JsValue state) {
  if (JS.invoke(state["handlers"], "has", name).truthy()) return;
  JsValue handler = JS.method1((JsValue _self, JsValue event) => {
    eventHandler(event, container, state);
    return JS.undefined();
  });
  JS.invoke(state["handlers"], "set", name, handler);
  JS.invoke(container, "addEventListener", name, handler);
