import { Error, console } from "../../dom-expressions/runtime/_host";

void throwInBrowser(string name) {
  JsValue error = JS.construct(Error, name + " is not supported in the browser, returning undefined");
  JS.invoke(console, "error", error);
}

export JsValue renderToString(JsValue fn, JsValue options = JS.undefined()) {
  throwInBrowser("renderToString");
  return JS.undefined();
}

export JsValue renderToStream(JsValue fn, JsValue options = JS.undefined()) {
  throwInBrowser("renderToStream");
  return JS.undefined();
}

export JsValue createResponseStub() {
  throwInBrowser("createResponseStub");
  return JS.undefined();
}

export JsValue createRequestEvent(JsValue request, JsValue options = JS.undefined()) {
  throwInBrowser("createRequestEvent");
  return JS.undefined();
}

export JsValue getExpectedRedirectStatus(JsValue response) {
  throwInBrowser("getExpectedRedirectStatus");
  return JS.undefined();
}

export JsValue createSSRResponse() {
  throwInBrowser("createSSRResponse");
  return JS.undefined();
}

export JsValue commitEventResponse(JsValue response, JsValue event = JS.undefined()) {
  throwInBrowser("commitEventResponse");
  return JS.undefined();
}

export JsValue composeMiddleware(JsValue middlewares) {
  throwInBrowser("composeMiddleware");
  return JS.undefined();
}

