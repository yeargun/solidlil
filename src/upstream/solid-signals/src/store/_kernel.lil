import {
  createMemo as hostCreateMemo,
  createOptimistic as hostCreateOptimistic
} from "../signals";
import {
  $REFRESH,
  CONFIG_AUTO_DISPOSE,
  Computed,
  NodeOptions,
  STATUS_ERROR,
  STATUS_PENDING,
  STATUS_UNINITIALIZED,
  Signal,
  getObserver as hostGetObserver,
  getOwner as hostGetOwner,
  read,
  recompute,
  setSignal,
  signal,
  suppressComputedRecompute,
  untrack as hostUntrack
} from "../core/index";
import {
  notifyDevStoreNodeUpdate,
  markPendingProbeFound,
  pendingCheckIsActive,
  refresh as refreshProjectionNode,
  refreshPendingState,
  strictRead,
  writeOptimisticNode
} from "../core/kernel";
import { throwPendingUntrackedRead } from "../core/dev";
import { insertSubs, schedule, setProjectionWriteActive, trackOptimisticStore } from "../core/scheduler";
import {
  Array,
  Error,
  Map,
  Object,
  Proxy,
  Reflect,
  Set,
  Symbol,
  TypeError,
  WeakMap,
  WeakSet,
  globalThis
} from "../../../_host";


export JsValue $TRACK_VALUE = JS.call(Symbol, JS.undefined(), "STORE_TRACK");
export JsValue $TARGET_VALUE = JS.call(Symbol, JS.undefined(), "STORE_TARGET");
export JsValue $PROXY_VALUE = JS.call(Symbol, JS.undefined(), "STORE_PROXY");
export JsValue $DELETED_VALUE = JS.call(Symbol, JS.undefined(), "STORE_DELETED");
export JsValue $PATH_DELETE_VALUE = JS.call(Symbol, JS.undefined(), "STORE_PATH_DELETE");
JsValue $MERGE_SOURCES_VALUE = JS.call(Symbol, JS.undefined(), "MERGE_SOURCES");

JsValue storeLookup = JS.construct(WeakMap);
JsValue rawValues = JS.construct(WeakSet);
int writeDepth = 0;
int projectionDepth = 0;
int reconcileDepth = 0;

JsValue undef() {
  return JS.undefined();
}

bool isUndefined(JsValue value) {
  return JS.isUndefined(value);
}

bool same(JsValue left, JsValue right) {
  return JS.invoke(Object, "is", left, right).truthy();
}

bool hasOwn(JsValue value, JsValue key) {
  return JS.call(Object["prototype"]["hasOwnProperty"], value, key).truthy();
}

bool inValue(JsValue key, JsValue value) {
  return JS.in(key, value);
}

int lengthOf(JsValue value) {
  return JS.number(value["length"]).toInt();
}

JsValue newNullObject() {
  return JS.invoke(Object, "create", null);
}

JsValue ownKeys(JsValue value) {
  return JS.invoke(Reflect, "ownKeys", value);
}

JsValue descriptor(JsValue value, JsValue key) {
  return JS.invoke(Reflect, "getOwnPropertyDescriptor", value, key);
}

JsValue getPrototype(JsValue value) {
  return JS.invoke(Object, "getPrototypeOf", value);
}

JsValue weakGet(JsValue map, JsValue key) {
  return JS.invoke(map, "get", key);
}

void weakSet(JsValue map, JsValue key, JsValue value) {
  JS.invoke(map, "set", key, value);
}

bool weakHas(JsValue map, JsValue key) {
  return JS.invoke(map, "has", key).truthy();
}

bool isObjectLike(JsValue value) {
  if (JS.isNullish(value)) return false;
  string kind = JS.typeOf(value);
  return kind == "object" || kind == "function";
}

bool isUnsafeKey(JsValue key) {
  if (JS.typeOf(key) != "string") return false;
  return JS.strictEqual(key, "__proto__");
}

bool isUnsafePathKey(JsValue key) {
  if (JS.typeOf(key) != "string") return false;
  return JS.strictEqual(key, "__proto__") ||
    JS.strictEqual(key, "constructor") ||
    JS.strictEqual(key, "prototype");
}

bool isEnumerable(JsValue value, JsValue key) {
  JsValue desc = descriptor(value, key);
  return desc.truthy() && desc["enumerable"].truthy();
}

export JsValue ownEnumerableKeysKernel(JsValue value) {
  JsValue keys = ownKeys(value);
  JsValue result = JS.array();
  for (int index = 0; index < lengthOf(keys); index++) {
    JsValue key = keys[index];
    if (isEnumerable(value, key)) JS.invoke(result, "push", key);
  }
  return result;
}

export bool isWrappableKernel(JsValue value) {
  if (JS.isNullish(value) || JS.typeOf(value) != "object") return false;
  if (JS.invoke(Object, "isFrozen", value).truthy()) return false;
  if (JS.isArray(value)) return true;
  JsValue proto = getPrototype(value);
  if (JS.isNullish(proto) || JS.strictEqual(proto, Object["prototype"])) return true;
  if (!JS.strictEqual(JS.call(Object["prototype"]["toString"], value), "[object Object]")) {
    return false;
  }
  JsValue nodeConstructor = globalThis["Node"];
  if (!JS.isUndefined(nodeConstructor) &&
      JS.invoke(nodeConstructor["prototype"], "isPrototypeOf", value).truthy()) return false;
  return true;
}

bool isRaw(JsValue value) {
  return isObjectLike(value) && JS.invoke(rawValues, "has", value).truthy();
}

void markRaw(JsValue value) {
  if (isWrappableKernel(value) && !value[$TARGET_VALUE].truthy()) JS.invoke(rawValues, "add", value);
}

export void markRawIngestKernel(JsValue value) {
  if (!isWrappableKernel(value)) return;
  JsValue keys = ownEnumerableKeysKernel(value);
  for (int index = 0; index < lengthOf(keys); index++) markRaw(value[keys[index]]);
}

JsValue sourceValue(JsValue meta, JsValue key) {
  JsValue overlays = meta["overlays"];
  if (hasOwn(overlays, key)) return overlays[key];
  return JS.invoke(Reflect, "get", meta["source"], key, meta["proxy"]);
}

bool sourceHas(JsValue meta, JsValue key) {
  JsValue overlays = meta["overlays"];
  if (hasOwn(overlays, key)) return !JS.strictEqual(overlays[key], $DELETED_VALUE);
  return inValue(key, meta["source"]);
}

JsValue sourceOwnDescriptor(JsValue meta, JsValue key) {
  JsValue descriptors = meta["descriptors"];
  if (hasOwn(descriptors, key)) return descriptors[key];
  if (hasOwn(meta["overlays"], key)) {
    if (JS.strictEqual(meta["overlays"][key], $DELETED_VALUE)) {
      if (meta["optimistic"].truthy()) {
        JsValue hasNode = meta["hasNodes"][key];
        if (hasNode.truthy() && nodeRead(hasNode).truthy()) {
          return descriptor(meta["source"], key);
        }
      }
      return undef();
    }
    JsValue base = descriptor(meta["source"], key);
    if (base.truthy() && (base["get"].truthy() || base["set"].truthy())) return base;
    if (base.truthy() && !base["get"].truthy() && !base["set"].truthy()) {
      return JS.object(
        "value", meta["overlays"][key],
        "writable", true,
        "enumerable", base["enumerable"],
        "configurable", true
      );
    }
    return JS.object(
      "value", meta["overlays"][key],
      "writable", true,
      "enumerable", true,
      "configurable", true
    );
  }
  return descriptor(meta["source"], key);
}

JsValue nodeRead(JsValue node) {
  if (JS.isArray(node)) {
    JsValue accessor = node[0];
    return JS.call(accessor, undef());
  }
  Signal<JsValue> signalNode = JS.assume(node);
  return read(signalNode);
}

void observePendingBlockers(JsValue node) {
  if (!pendingCheckIsActive()) return;
  JsValue raw = node;
  if (JS.isArray(node)) {
    JsValue refreshKey = JS.assume($REFRESH);
    raw = node[0][refreshKey];
  }
  if (raw["_hasPending"].truthy() && JS.number(raw["_pendingOwner"]).toInt() != 0) {
    markPendingProbeFound();
  }
  JsValue link = raw["_subs"];
  while (link.truthy()) {
    JsValue dependent = link["_sub"];
    if (dependent["_computed"].truthy() &&
        (JS.number(dependent["_statusFlags"]).toInt() & STATUS_PENDING) != 0) {
      JsValue pending = dependent["_pendingSignal"];
      if (JS.isNullish(pending)) {
        NodeOptions<bool> options = new NodeOptions<bool>();
        options.ownedWrite = true;
        options.noSnapshot = true;
        Signal<bool> created = signal(true, options);
        created._parentSource = JS.assume(dependent);
        created._pendingCompanion = true;
        dependent["_pendingSignal"] = JS.assume(created);
        pending = JS.assume(created);
      }
      Signal<bool> pendingSignal = JS.assume(pending);
      read(pendingSignal);
    }
    link = link["_nextSub"];
  }
}

JsValue visibleNodeValue(JsValue node) {
  JsValue raw = node;
  if (JS.isArray(node)) {
    JsValue accessor = node[0];
    JsValue refreshKey = JS.assume($REFRESH);
    raw = accessor[refreshKey];
  }
  if (raw["_overrideActive"].truthy()) return raw["_overrideValue"];
  if (raw["_hasPending"].truthy()) return raw["_pendingValue"];
  return raw["_value"];
}

void publishActionPending(JsValue raw) {
  if (!raw["_hasPending"].truthy() || JS.number(raw["_pendingOwner"]).toInt() == 0) return;
  JsValue pending = raw["_pendingSignal"];
  if (JS.isNullish(pending)) {
    NodeOptions<bool> options = new NodeOptions<bool>();
    options.ownedWrite = true;
    options.noSnapshot = true;
    Signal<bool> created = signal(false, options);
    created._parentSource = JS.assume(raw);
    created._pendingCompanion = true;
    raw["_pendingSignal"] = JS.assume(created);
    pending = JS.assume(created);
  }
  Signal<JsValue> pendingSignal = JS.assume(pending);
  writeOptimisticNode(pendingSignal, true);
}

void nodeWrite(JsValue meta, JsValue node, JsValue value) {
  JsValue raw = node;
  if (JS.isArray(node)) {
    JsValue refreshKey = JS.assume($REFRESH);
    raw = node[0][refreshKey];
  }
  if (meta["projection"].truthy() && meta["refresh"].truthy()) {
    if (projectionDepth > 0) raw["_parentSource"] = meta["refresh"];
    else raw["_parentSource"] = null;
  }
  if (projectionDepth > 0 && meta["refresh"].truthy()) {
    meta["refresh"]["_reask"] = false;
  }
  if (JS.isArray(node)) {
    JsValue next = value;
    JS.call(node[1], undef(), JS.method0((JsValue _self) => next));
    publishActionPending(raw);
    return;
  }
  Signal<JsValue> signalNode = JS.assume(node);
  if (meta["optimistic"].truthy() && projectionDepth == 0) {
    writeOptimisticNode(signalNode, value);
  } else {
    setSignal(signalNode, value);
  }
  publishActionPending(raw);
}

JsValue createNode(JsValue meta, JsValue value) {
  NodeOptions<JsValue> options = new NodeOptions<JsValue>();
  Signal<JsValue> node = signal(value, options);
  if (meta["optimistic"].truthy() && projectionDepth == 0) {
    JsValue rawOptions = JS.object("_skipGraph", true);
    if (JS.typeOf(value) == "function") {
      JsValue functionValue = value;
      value = JS.method0((JsValue _self) => functionValue);
    }
    JsValue optimisticNode = hostCreateOptimistic(value, rawOptions);
    if (meta["refresh"].truthy()) {
      JsValue optimisticAccessor = optimisticNode[0];
      JsValue refreshKey = JS.assume($REFRESH);
      Signal<JsValue> rawOptimisticNode = JS.assume(optimisticAccessor[refreshKey]);
      rawOptimisticNode._parentSource = JS.assume(meta["refresh"]);
    }
    return optimisticNode;
  }
  if (meta["refresh"].truthy()) {
    Signal<JsValue> parent = JS.assume(meta["refresh"]);
    node._parentSource = parent;
  }
  return JS.assume(node);
}

void ensureChainedBridge(JsValue meta, JsValue key, JsValue node) {
  if (
    projectionDepth > 0 ||
    !meta["optimistic"].truthy() ||
    !meta["source"][$TARGET_VALUE].truthy() ||
    JS.strictEqual(key, $TRACK_VALUE) ||
    hasOwn(meta["bridges"], key)
  ) return;
  JsValue heldNode = node;
  JsValue property = key;
  bool initialized = false;
  // Keep wrapper consumers off the inner store's graph so an outer optimistic
  // overlay can hold the whole view until its transition settles.
  JsValue bridge = hostCreateMemo(JS.method0((JsValue _self) => {
    JsValue next = JS.invoke(Reflect, "get", meta["source"], property, meta["proxy"]);
    if (initialized && lengthOf(ownKeys(meta["overlays"])) == 0) {
      JsValue raw = heldNode;
      if (JS.isArray(heldNode)) {
        JsValue refreshKey = JS.assume($REFRESH);
        raw = heldNode[0][refreshKey];
      }
      Signal<JsValue> signalNode = JS.assume(raw);
      insertSubs(signalNode, true);
      schedule();
    }
    initialized = true;
    return next;
  }), null);
  JsValue refreshKey = JS.assume($REFRESH);
  Computed<JsValue> bridgeNode = JS.assume(bridge[refreshKey]);
  bridgeNode._config = bridgeNode._config ^ (bridgeNode._config & CONFIG_AUTO_DISPOSE);
  meta["bridges"][key] = bridge;
}

JsValue getNode(JsValue meta, JsValue collection, JsValue key, JsValue value) {
  JsValue node = collection[key];
  if (node.truthy()) return node;
  if (
    projectionDepth == 0 &&
    meta["optimistic"].truthy() &&
    meta["source"][$TARGET_VALUE].truthy() &&
    JS.strictEqual(collection, meta["nodes"]) &&
    !JS.strictEqual(key, $TRACK_VALUE)
  ) {
    node = createNode(meta, value);
    ensureChainedBridge(meta, key, node);
  } else {
    node = createNode(meta, value);
  }
  collection[key] = node;
  JsValue current = meta;
  while (current.truthy() && !current["descendant"].truthy()) {
    current["descendant"] = true;
    current = current["parent"];
  }
  return node;
}

bool hasObserver() {
  return !JS.isNullish(hostGetObserver());
}

void ensureProjection(JsValue meta) {
  JsValue projection = meta["projection"];
  if (projection.truthy() && projectionDepth == 0 && writeDepth == 0) {
    try {
      JsValue projectionRef = projection;
      JsValue refresh = meta["refresh"];
      JsValue refreshKey = JS.assume($REFRESH);
      Computed<JsValue> projectionNode = JS.assume(projectionRef[refreshKey]);
      if (
        !meta["initialized"].truthy() &&
        refresh.truthy() &&
        refresh["_initialized"].truthy() &&
        (projectionNode._statusFlags & STATUS_UNINITIALIZED) != 0
      ) {
        recompute(projectionNode, false);
      }
      bool retryError = refresh.truthy() &&
        (JS.number(refresh["_statusFlags"]).toInt() & STATUS_ERROR) != 0 &&
        hasObserver();
      if (retryError && !meta["errorRetryArmed"].truthy()) {
        meta["errorRetryArmed"] = true;
        Computed<JsValue> refreshNode = JS.assume(refresh);
        refreshProjectionNode(refreshNode);
      }
      if (pendingCheckIsActive() || retryError) {
        JS.call(projectionRef, undef());
      } else {
        hostUntrack(JS.method0((JsValue _self) => JS.call(projectionRef, undef())), undef());
      }
      if (meta["refresh"].truthy() && meta["refresh"]["_initialized"].truthy()) {
        meta["initialized"] = true;
      }
    } catch (JsValue failure) {
      bool initialized = meta["initialized"].truthy();
      if (!initialized || !JS.strictEqual(failure["_kind"], "not-ready")) {
        throw failure;
      }
    }
  }
}

void guardProjectionRead(JsValue meta) {
  if (projectionDepth > 0 || writeDepth > 0) return;
  JsValue refresh = meta["refresh"];
  if (!refresh.truthy()) return;
  int status = JS.number(refresh["_statusFlags"]).toInt();
  if (
    strictRead != null &&
    !pendingCheckIsActive() &&
    (status & STATUS_PENDING) != 0
  ) {
    throwPendingUntrackedRead(JS.assume(strictRead));
  }
  if (
    pendingCheckIsActive() &&
    (status & STATUS_PENDING) != 0 &&
    (status & STATUS_UNINITIALIZED) != 0
  ) {
    JsValue owner = JS.assume(hostGetOwner());
    if (!JS.isNullish(owner) && !owner["_computed"].truthy()) throw refresh["_error"];
  }
}

void trackSelf(JsValue meta) {
  if (writeDepth > 0 || !hasObserver()) return;
  JsValue nodes = meta["nodes"];
  nodeRead(getNode(meta, nodes, $TRACK_VALUE, undef()));
  if (
    lengthOf(ownKeys(meta["overlays"])) == 0 &&
    meta["source"][$TARGET_VALUE].truthy()
  ) {
    meta["source"][$TRACK_VALUE];
  }
}

JsValue currentValue(JsValue meta, JsValue key, bool tracked) {
  guardProjectionRead(meta);
  ensureProjection(meta);
  if (writeDepth > 0 && JS.strictEqual(key, "constructor") &&
      !hasOwn(meta["source"], key) && !hasOwn(meta["overlays"], key)) return undef();
  JsValue nodes = meta["nodes"];
  JsValue node = nodes[key];
  if (writeDepth == 0 && !hasObserver() && hasOwn(meta["direct"], key)) {
    JsValue direct = sourceValue(meta, key);
    if (JS.strictEqual(direct, $DELETED_VALUE)) direct = undef();
    return wrapKernel(direct, meta);
  }
  if (writeDepth == 0 && meta["projection"].truthy() && !hasObserver()) {
    JsValue projected = sourceValue(meta, key);
    if (JS.strictEqual(projected, $DELETED_VALUE)) projected = undef();
    return wrapKernel(projected, meta);
  }
  if (node.truthy() && (writeDepth == 0 || meta["optimistic"].truthy())) {
    observePendingBlockers(node);
    if (meta["source"][$TARGET_VALUE].truthy() && lengthOf(ownKeys(meta["overlays"])) == 0) {
      if (writeDepth == 0 && meta["optimistic"].truthy()) {
        ensureChainedBridge(meta, key, node);
        nodeRead(node);
        JsValue property = key;
        JsValue chained = hostUntrack(
          JS.method0((JsValue _self) => sourceValue(meta, property)),
          undef()
        );
        return wrapKernel(chained, meta);
      }
      if (writeDepth == 0) nodeRead(node);
      return wrapKernel(sourceValue(meta, key), meta);
    }
    if (writeDepth > 0) return wrapKernel(visibleNodeValue(node), meta);
    return wrapKernel(nodeRead(node), meta);
  }
  JsValue value = undef();
  if (
    writeDepth == 0 &&
    tracked &&
    hasObserver() &&
    meta["optimistic"].truthy() &&
    meta["source"][$TARGET_VALUE].truthy() &&
    lengthOf(ownKeys(meta["overlays"])) == 0
  ) {
    JsValue property = key;
    value = hostUntrack(
      JS.method0((JsValue _self) => sourceValue(meta, property)),
      undef()
    );
  } else {
    value = sourceValue(meta, key);
  }
  if (JS.strictEqual(value, $DELETED_VALUE)) value = undef();
  if (writeDepth == 0 && tracked && hasObserver()) {
    if (JS.typeOf(value) == "function" &&
        !hasOwn(meta["source"], key) && !hasOwn(meta["overlays"], key)) return value;
    value = wrapKernel(value, meta);
    return nodeRead(getNode(meta, nodes, key, value));
  }
  return wrapKernel(value, meta);
}

bool currentHas(JsValue meta, JsValue key, bool tracked) {
  guardProjectionRead(meta);
  ensureProjection(meta);
  JsValue nodes = meta["hasNodes"];
  JsValue node = nodes[key];
  if (writeDepth == 0 && !hasObserver() && hasOwn(meta["direct"], key)) {
    return sourceHas(meta, key);
  }
  if (node.truthy() && (writeDepth == 0 || meta["optimistic"].truthy())) {
    observePendingBlockers(node);
    if (meta["source"][$TARGET_VALUE].truthy() && lengthOf(ownKeys(meta["overlays"])) == 0) {
      if (writeDepth == 0) nodeRead(node);
      return sourceHas(meta, key);
    }
    if (writeDepth > 0) return visibleNodeValue(node).truthy();
    return nodeRead(node).truthy();
  }
  bool present = sourceHas(meta, key);
  if (writeDepth == 0 && tracked && hasObserver()) {
    return nodeRead(getNode(meta, nodes, key, present)).truthy();
  }
  return present;
}

bool isArrayIndex(JsValue key) {
  if (JS.typeOf(key) != "string") return false;
  if (JS.strictEqual(key, "")) return false;
  float numeric = JS.number(key);
  if (numeric < 0 || numeric > 4294967294.0) return false;
  return numeric == numeric.toInt() && JS.strictEqual(JS.string(numeric.toInt()), key);
}

void notifyNode(JsValue meta, JsValue key, JsValue previous, JsValue next) {
  JsValue nodes = meta["nodes"];
  JsValue node = nodes[key];
  if (!node.truthy() && projectionDepth > 0) {
    getNode(meta, nodes, key, wrapKernel(next, meta));
    return;
  }
  if (!node.truthy()) node = getNode(meta, nodes, key, wrapKernel(previous, meta));
  nodeWrite(meta, node, wrapKernel(next, meta));
}

void notifyPresence(JsValue meta, JsValue key, bool previous, bool next) {
  JsValue nodes = meta["hasNodes"];
  JsValue node = nodes[key];
  if (!node.truthy() && projectionDepth > 0) {
    getNode(meta, nodes, key, next);
    return;
  }
  if (!node.truthy() && previous != next) node = getNode(meta, nodes, key, previous);
  if (node.truthy()) nodeWrite(meta, node, next);
}

void notifyStructure(JsValue meta) {
  JsValue node = meta["nodes"][$TRACK_VALUE];
  if (node.truthy()) nodeWrite(meta, node, JS.object());
}

void freezeChainedNodes(JsValue meta) {
  if (!meta["source"][$TARGET_VALUE].truthy() || lengthOf(ownKeys(meta["overlays"])) > 0) return;
  JsValue collections = JS.array(meta["nodes"], meta["hasNodes"]);
  JsValue refreshKey = JS.assume($REFRESH);
  for (int collectionIndex = 0; collectionIndex < lengthOf(collections); collectionIndex++) {
    JsValue keys = ownKeys(collections[collectionIndex]);
    for (int index = 0; index < lengthOf(keys); index++) {
      JsValue entry = collections[collectionIndex][keys[index]];
      JsValue raw = entry;
      if (JS.isArray(entry)) raw = entry[0][refreshKey];
      Signal<JsValue> signalNode = JS.assume(raw);
      JsValue key = keys[index];
      if (!JS.strictEqual(key, $TRACK_VALUE)) {
        JsValue next = if (collectionIndex == 1) {
          JS.assume(inValue(key, meta["source"]))
        } else {
          wrapKernel(
            JS.invoke(Reflect, "get", meta["source"], key, meta["proxy"]),
            meta
          )
        };
        signalNode._value = next;
        signalNode._pendingValue = next;
        signalNode._hasPending = false;
      }
      bool equalsEnabled = signalNode._equalsEnabled;
      signalNode._equalsEnabled = false;
      writeOptimisticNode(signalNode, visibleNodeValue(entry));
      signalNode._equalsEnabled = equalsEnabled;
    }
  }
}

void stageValue(JsValue meta, JsValue key, JsValue next, bool deleting) {
  if (isUnsafeKey(key)) return;
  JsValue previous = sourceValue(meta, key);
  bool previousHas = sourceHas(meta, key);
  JsValue optimisticBase = meta["optimisticBase"];
  if (
    meta["optimistic"].truthy() &&
    projectionDepth > 0 &&
    hasOwn(optimisticBase, key)
  ) {
    previous = optimisticBase[key];
    previousHas = !JS.strictEqual(previous, $DELETED_VALUE);
  } else if (meta["optimistic"].truthy()) {
    previous = currentValue(meta, key, false);
    previousHas = currentHas(meta, key, false);
  }
  bool nextHas = !deleting;
  if (deleting && !previousHas) return;
  if (!deleting && previousHas && same(previous, next)) return;
  if (
    meta["optimistic"].truthy() &&
    projectionDepth > 0 &&
    hasOwn(optimisticBase, key)
  ) {
    optimisticBase[key] = if (deleting) { $DELETED_VALUE } else { next };
    JsValue previousValue = if (previousHas) { previous } else { undef() };
    JsValue nextValue = if (deleting) { undef() } else { next };
    notifyNode(meta, key, previousValue, nextValue);
    notifyPresence(meta, key, previousHas, nextHas);
    notifyStructure(meta);
    notifyDevStoreNodeUpdate(meta["proxy"], key, nextValue, previousValue);
    return;
  }
  if (meta["optimistic"].truthy() && projectionDepth == 0) {
    freezeChainedNodes(meta);
    trackOptimisticStore(meta);
  }
  if (meta["optimistic"].truthy() && projectionDepth == 0) {
    JsValue optimisticBase = meta["optimisticBase"];
    if (!hasOwn(optimisticBase, key)) {
      optimisticBase[key] = if (previousHas) { previous } else { $DELETED_VALUE };
    }
  }
  if (deleting) meta["overlays"][key] = $DELETED_VALUE;
  else meta["overlays"][key] = next;
  if (projectionDepth > 0 || reconcileDepth > 0) meta["direct"][key] = true;
  else JS.delete(meta["direct"], key);
  JS.delete(meta["descriptors"], key);
  if (meta["shallow"].truthy() && !deleting) markRaw(next);
  JsValue previousValue = undef();
  if (previousHas) previousValue = previous;
  JsValue nextValue = next;
  if (deleting) nextValue = undef();
  notifyNode(meta, key, previousValue, nextValue);
  notifyPresence(meta, key, previousHas, nextHas);
  notifyStructure(meta);
  notifyDevStoreNodeUpdate(meta["proxy"], key, nextValue, previousValue);

  if (JS.isArray(meta["source"]) && !JS.strictEqual(key, "length") && isArrayIndex(key)) {
    int index = JS.number(key).toInt();
    int currentLength = JS.number(sourceValue(meta, "length")).toInt();
    if (!deleting && index >= currentLength) stageValue(meta, "length", index + 1, false);
  }
