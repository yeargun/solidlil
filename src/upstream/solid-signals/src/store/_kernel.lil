    JsValue previousValue = undef();
    if (previousHas) previousValue = previous;
    notifyNode(meta, key, previousValue, JS.object());
    notifyPresence(meta, key, previousHas, true);
    notifyStructure(meta);
    JsValue next = undef();
    if (desc["get"].truthy()) next = JS.call(desc["get"], meta["proxy"]);
    notifyDevStoreNodeUpdate(meta["proxy"], key, next, previousValue);
