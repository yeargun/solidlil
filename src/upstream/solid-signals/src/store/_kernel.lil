  if (desc["get"].truthy() || desc["set"].truthy()) {
    return JS.object(
      "get", desc["get"],
      "set", desc["set"],
      "enumerable", desc["enumerable"],
      "configurable", true
    );
  }
  return JS.object(
    "value", currentValue(meta, key, false),
    "writable", desc["writable"],
    "enumerable", desc["enumerable"],
    "configurable", true
