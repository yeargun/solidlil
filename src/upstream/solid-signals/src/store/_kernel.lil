export JsValue createStoreProxyKernel(JsValue source, bool shallow, bool optimistic) {
  return createStoreProxyFamily(source, shallow, optimistic, null);
}

void appendAffectsNode(JsValue output, JsValue node) {
  if (!node.truthy()) return;
  if (JS.isArray(node)) {
    JsValue refreshKey = JS.assume($REFRESH);
    node = node[0][refreshKey];
  }
  if (node.truthy() && !JS.invoke(output, "includes", node).truthy()) {
    JS.invoke(output, "push", node);
  }
}

void collectStoreAffectsNodes(JsValue meta, JsValue output, JsValue seen) {
  if (!meta.truthy() || JS.invoke(seen, "has", meta).truthy()) return;
  JS.invoke(seen, "add", meta);
  JsValue collections = JS.array(meta["nodes"], meta["hasNodes"]);
  for (int collectionIndex = 0; collectionIndex < lengthOf(collections); collectionIndex++) {
    JsValue collection = collections[collectionIndex];
    JsValue nodeKeys = ownKeys(collection);
    for (int index = 0; index < lengthOf(nodeKeys); index++) {
      appendAffectsNode(output, collection[nodeKeys[index]]);
    }
  }
  JsValue keys = mergedOwnKeysMode(meta, false);
  for (int index = 0; index < lengthOf(keys); index++) {
    JsValue value = currentValue(meta, keys[index], false);
    if (isObjectLike(value) && value[$TARGET_VALUE].truthy()) {
      collectStoreAffectsNodes(value[$TARGET_VALUE], output, seen);
    }
  }
}

export JsValue getStoreAffectsNodesKernel(JsValue meta, JsValue key) {
  JsValue output = JS.array();
  if (!meta.truthy()) return output;
  if (!JS.isUndefined(key)) {
    JsValue value = currentValue(meta, key, false);
    appendAffectsNode(output, getNode(meta, meta["nodes"], key, value));
    return output;
  }
  appendAffectsNode(output, getNode(meta, meta["nodes"], $TRACK_VALUE, undef()));
  collectStoreAffectsNodes(meta, output, JS.construct(WeakSet));
  return output;
}

export JsValue wrapKernel(JsValue value, JsValue parentMeta) {
  if (!isWrappableKernel(value) || isRaw(value)) return value;
  JsValue target = value[$TARGET_VALUE];
  if (parentMeta.truthy() && parentMeta["shallow"].truthy() && !target.truthy()) return value;
  JsValue family = null;
  if (parentMeta.truthy()) family = parentMeta["family"];
  if (target.truthy()) {
    if (!family.truthy() || JS.strictEqual(target["family"], family)) return value;
  }
  JsValue lookup = storeLookup;
  if (family.truthy()) lookup = family;
  JsValue present = weakGet(lookup, value);
  if (present.truthy()) return present;
  if (family.truthy() && family["keyed"].truthy()) {
    JsValue identity = keyOf(value, family["key"]);
    if (!isUndefined(identity) && !JS.isNullish(identity)) {
      JsValue keyed = JS.invoke(family["keyed"], "get", identity);
      if (keyed.truthy()) {
        JsValue keyedMeta = keyed[$TARGET_VALUE];
        keyedMeta["source"] = value;
        weakSet(family, value, keyed);
        return keyed;
      }
