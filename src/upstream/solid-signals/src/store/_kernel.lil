  bool optimistic = parentMeta.truthy() && parentMeta["optimistic"].truthy();
  JsValue proxy = createStoreProxyFamily(value, false, optimistic, family);
  if (family.truthy() && family["keyed"].truthy()) {
    JsValue identity = keyOf(value, family["key"]);
    if (!isUndefined(identity) && !JS.isNullish(identity)) {
      JS.invoke(family["keyed"], "set", identity, proxy);
    }
  }
