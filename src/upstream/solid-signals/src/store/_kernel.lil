JsValue mergedOwnKeys(JsValue meta) {
  return mergedOwnKeysMode(meta, true);
}

JsValue proxyDescriptor(JsValue meta, JsValue actualTarget, JsValue key) {
  bool present = sourceHas(meta, key);
  if (meta["optimistic"].truthy()) present = currentHas(meta, key, false);
  if (!present) return undef();
  if (JS.isArray(meta["source"]) && JS.strictEqual(key, "length")) {
    return descriptor(actualTarget, key);
  }
  JsValue desc = sourceOwnDescriptor(meta, key);
  if (!desc.truthy()) {
    return JS.object(
      "value", currentValue(meta, key, false),
      "writable", true,
      "enumerable", true,
      "configurable", true
