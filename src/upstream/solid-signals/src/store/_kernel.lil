JsValue createStoreProxyFamily(JsValue source, bool shallow, bool optimistic, JsValue family) {
  JsValue lookup = storeLookup;
  if (family.truthy()) lookup = family;
  JsValue present = weakGet(lookup, source);
  if (present.truthy()) return present;
  JsValue actual = JS.array();
  if (!JS.isArray(source)) actual = JS.invoke(Object, "create", getPrototype(source));
  JsValue meta = JS.object(
    "source", source,
    "overlays", newNullObject(),
    "direct", newNullObject(),
    "descriptors", newNullObject(),
    "nodes", newNullObject(),
    "hasNodes", newNullObject(),
    "proxy", null,
    "shallow", shallow,
    "optimistic", optimistic,
    "projection", null,
    "refresh", null,
    "family", family,
    "bridges", newNullObject(),
    "optimisticBase", newNullObject()
  );
  meta["parent"] = null;
  meta["descendant"] = false;
  meta["epoch"] = 0;
  meta["initialized"] = false;
  meta["asyncResult"] = false;
  meta["replaceChildren"] = false;
  meta["errorRetryArmed"] = false;
  meta["_clearOptimistic"] = JS.method0((JsValue _self) => {
    if (meta["refresh"].truthy() && (JS.number(meta["refresh"]["_statusFlags"]).toInt() & 1) != 0) {
      return true;
    }
    JsValue optimisticBase = meta["optimisticBase"];
    JsValue baseKeys = ownKeys(optimisticBase);
    JsValue refreshKey = JS.assume($REFRESH);
    bool remaining = false;
    for (int index = 0; index < lengthOf(baseKeys); index++) {
      JsValue key = baseKeys[index];
      bool active = false;
      JsValue collections = JS.array(meta["nodes"], meta["hasNodes"]);
      for (int collectionIndex = 0; collectionIndex < lengthOf(collections); collectionIndex++) {
        JsValue entry = collections[collectionIndex][key];
        if (!entry.truthy()) continue;
        JsValue raw = entry;
        if (JS.isArray(entry)) raw = entry[0][refreshKey];
        if (raw.truthy() && raw["_overrideActive"].truthy()) active = true;
      }
      if (active) {
        remaining = true;
        continue;
      }
      if (meta["source"][$TARGET_VALUE].truthy()) {
        JS.delete(meta["overlays"], key);
        JS.delete(meta["direct"], key);
      } else {
        meta["overlays"][key] = optimisticBase[key];
        meta["direct"][key] = true;
      }
      JS.delete(optimisticBase, key);
    }
    if (!remaining) meta["optimisticBase"] = newNullObject();
    if (!remaining && meta["source"][$TARGET_VALUE].truthy()) {
      JsValue bridgeKeys = ownKeys(meta["bridges"]);
      for (int index = 0; index < lengthOf(bridgeKeys); index++) {
        JsValue key = bridgeKeys[index];
        JsValue entry = meta["nodes"][key];
        if (!entry.truthy()) continue;
