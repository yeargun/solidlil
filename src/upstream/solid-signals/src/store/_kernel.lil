}

void replaceStoreValue(JsValue value, JsValue proxy) {
  if (JS.isArray(value)) {
    for (int index = 0; index < lengthOf(value); index++) proxy[index] = value[index];
    proxy["length"] = lengthOf(value);
    return;
  }
  JsValue nextKeys = ownEnumerableKeysKernel(value);
  JsValue nextSet = JS.construct(Set);
  for (int index = 0; index < lengthOf(nextKeys); index++) {
    JsValue key = nextKeys[index];
    if (isUnsafeKey(key)) continue;
    JS.invoke(nextSet, "add", key);
    proxy[key] = value[key];
  }
  JsValue meta = proxy[$TARGET_VALUE];
  JsValue previousKeys = mergedOwnKeys(meta);
  for (int index = 0; index < lengthOf(previousKeys); index++) {
    JsValue key = previousKeys[index];
    if (!JS.invoke(nextSet, "has", key).truthy()) JS.delete(proxy, key);
  }
}

void clearOptimisticNodes(JsValue collection) {
  JsValue keys = ownKeys(collection);
  JsValue refreshKey = JS.assume($REFRESH);
  for (int index = 0; index < lengthOf(keys); index++) {
    JsValue node = collection[keys[index]];
    JsValue raw = node;
    if (JS.isArray(node)) raw = node[0][refreshKey];
    if (!raw.truthy()) continue;
    JsValue previous = raw["_overrideValue"];
    raw["_overrideActive"] = false;
    raw["_overrideValue"] = undef();
    raw["_overrideOwner"] = 0;
    raw["_optimisticLane"] = null;
    Signal<JsValue> pendingNode = JS.assume(raw);
    refreshPendingState(pendingNode);
    JsValue visible = if (raw["_hasPending"].truthy()) { raw["_pendingValue"] } else { raw["_value"] };
    if (!same(previous, visible)) {
      Signal<JsValue> signalNode = JS.assume(raw);
      insertSubs(signalNode, true);
    }
  }
}

void commitOptimisticNodes(JsValue meta, JsValue collection, bool presence) {
  JsValue keys = ownKeys(collection);
  JsValue refreshKey = JS.assume($REFRESH);
  for (int index = 0; index < lengthOf(keys); index++) {
    JsValue key = keys[index];
    JsValue node = collection[key];
    JsValue raw = node;
    if (JS.isArray(node)) raw = node[0][refreshKey];
    if (!raw.truthy()) continue;
    JsValue previous = visibleNodeValue(node);
    JsValue next = undef();
    if (presence) next = sourceHas(meta, key);
    else if (JS.strictEqual(key, $TRACK_VALUE)) next = JS.object();
    else next = wrapKernel(sourceValue(meta, key), meta);
    raw["_overrideActive"] = false;
    raw["_overrideValue"] = undef();
    raw["_overrideOwner"] = 0;
    raw["_optimisticLane"] = null;
    raw["_value"] = next;
    raw["_pendingValue"] = next;
    raw["_hasPending"] = false;
    Signal<JsValue> signalNode = JS.assume(raw);
    refreshPendingState(signalNode);
    if (!same(previous, next)) insertSubs(signalNode, true);
  }
}

void clearProjectionOptimistic(JsValue meta) {
  JsValue optimisticBase = meta["optimisticBase"];
  JsValue keys = ownKeys(optimisticBase);
  for (int index = 0; index < lengthOf(keys); index++) {
    JsValue key = keys[index];
    meta["overlays"][key] = optimisticBase[key];
    meta["direct"][key] = true;
  }
  meta["optimisticBase"] = newNullObject();
  clearOptimisticNodes(meta["nodes"]);
  clearOptimisticNodes(meta["hasNodes"]);
}

JsValue makeSetter(JsValue proxy) {
  return JS.method1((JsValue _self, JsValue updater) => {
    JsValue meta = proxy[$TARGET_VALUE];
    if (
      meta["projection"].truthy() &&
      meta["refresh"].truthy() &&
      !meta["optimistic"].truthy()
    ) {
      Computed<JsValue> refreshNode = JS.assume(meta["refresh"]);
      suppressComputedRecompute(refreshNode);
    }
    writeDepth += 1;
    try {
      JsValue result = hostUntrack(
        JS.method0((JsValue _untrackSelf) => JS.call(updater, undef(), proxy)),
        undef()
      );
      if (!isUndefined(result) && !JS.strictEqual(result, proxy)) {
        replaceStoreValue(result, proxy);
