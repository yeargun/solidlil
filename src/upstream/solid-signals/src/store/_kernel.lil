      writeDepth -= 1;
    }
    return undef();
  });
}

JsValue option(JsValue options, string key) {
  if (JS.isNullish(options)) return undef();
  return options[key];
}

JsValue createPlainStore(JsValue initial, JsValue options, bool optimistic) {
  if (!isWrappableKernel(initial)) initial = JS.object();
  bool shallow = option(options, "shallow").truthy();
  JsValue family = null;
  if (optimistic) family = JS.construct(WeakMap);
  JsValue proxy = createStoreProxyFamily(initial, shallow, optimistic, family);
  return JS.array(proxy, makeSetter(proxy));
}

JsValue keyOf(JsValue item, JsValue key) {
  if (JS.isNullish(key) || !isObjectLike(item)) return undef();
  if (JS.typeOf(key) == "function") return JS.call(key, undef(), item);
  return item[key];
}

bool canRecurse(JsValue previous, JsValue next, JsValue key) {
  if (!isWrappableKernel(previous) || !isWrappableKernel(next) || isRaw(previous) || isRaw(next)) return false;
  if (JS.isArray(previous) != JS.isArray(next)) return false;
  if (JS.isNullish(key)) return true;
  JsValue left = keyOf(previous, key);
  JsValue right = keyOf(next, key);
  if (isUndefined(left) || JS.isNullish(left)) return true;
  return same(left, right);
}

bool shouldRecurse(JsValue previous, JsValue next, JsValue key, JsValue parentMeta, JsValue property) {
  if (!canRecurse(previous, next, key)) return false;
  if (parentMeta["replaceChildren"].truthy() && !JS.isNullish(key)) {
    JsValue left = keyOf(previous, key);
    JsValue right = keyOf(next, key);
    if ((isUndefined(left) || JS.isNullish(left)) &&
        (isUndefined(right) || JS.isNullish(right))) return false;
  }
  if (JS.isNullish(key)) return true;
  if (projectionDepth > 0 && previous[$TARGET_VALUE].truthy()) return true;
  if (parentMeta["nodes"][property].truthy() || parentMeta["nodes"][$TRACK_VALUE].truthy()) return true;
  JsValue childMeta = previous[$TARGET_VALUE];
  return childMeta.truthy() && childMeta["descendant"].truthy();
}

void writeKey(JsValue target, JsValue key, JsValue value) {
  target[key] = value;
}

void deleteKey(JsValue target, JsValue key) {
  JS.delete(target, key);
}

void reconcileArray(JsValue next, JsValue state, JsValue key) {
  JsValue parentMeta = state[$TARGET_VALUE];
  int previousLength = JS.number(state["length"]).toInt();
  int nextLength = lengthOf(next);
  JsValue previous = JS.array();
  for (int index = 0; index < previousLength; index++) JS.invoke(previous, "push", state[index]);

  if (JS.isNullish(key)) {
    for (int index = 0; index < nextLength; index++) {
      JsValue oldItem = undef();
      if (index < previousLength) oldItem = previous[index];
      JsValue nextItem = next[index];
      if (shouldRecurse(oldItem, nextItem, key, parentMeta, index)) {
        reconcileInto(nextItem, oldItem, key, false);
        if (projectionDepth > 0 && oldItem[$TARGET_VALUE].truthy()) {
          JsValue childMeta = oldItem[$TARGET_VALUE];
          childMeta["source"] = nextItem;
          childMeta["overlays"] = newNullObject();
          childMeta["direct"] = newNullObject();
          childMeta["descriptors"] = newNullObject();
          if (parentMeta["family"].truthy()) weakSet(parentMeta["family"], nextItem, oldItem);
        }
      } else writeKey(state, index, nextItem);
    }
  } else {
    JsValue byKey = JS.construct(Map);
    for (int index = 0; index < previousLength; index++) {
      JsValue oldItem = previous[index];
      JsValue oldKey = keyOf(oldItem, key);
      if (!isUndefined(oldKey) && !JS.isNullish(oldKey)) JS.invoke(byKey, "set", oldKey, oldItem);
    }
    for (int index = 0; index < nextLength; index++) {
      JsValue nextItem = next[index];
      JsValue nextKey = keyOf(nextItem, key);
      JsValue oldItem = undef();
      if (!isUndefined(nextKey) && !JS.isNullish(nextKey)) oldItem = JS.invoke(byKey, "get", nextKey);
      else if (index < previousLength) oldItem = previous[index];
      if (!isUndefined(oldItem) && shouldRecurse(oldItem, nextItem, key, parentMeta, index)) {
        reconcileInto(nextItem, oldItem, key, false);
        if (projectionDepth > 0 && oldItem[$TARGET_VALUE].truthy()) {
          JsValue childMeta = oldItem[$TARGET_VALUE];
          childMeta["source"] = nextItem;
          childMeta["overlays"] = newNullObject();
          childMeta["direct"] = newNullObject();
          childMeta["descriptors"] = newNullObject();
          if (parentMeta["family"].truthy()) weakSet(parentMeta["family"], nextItem, oldItem);
        }
        if (index >= previousLength || !same(oldItem, previous[index])) {
          writeKey(state, index, oldItem);
        }
      } else writeKey(state, index, nextItem);
    }
  }
  state["length"] = nextLength;
}

void reconcileObject(JsValue next, JsValue state, JsValue key) {
  JsValue parentMeta = state[$TARGET_VALUE];
  JsValue nextKeys = ownEnumerableKeysKernel(next);
  JsValue nextSet = JS.construct(Set);
  for (int index = 0; index < lengthOf(nextKeys); index++) {
    JsValue property = nextKeys[index];
    if (isUnsafeKey(property)) continue;
    JS.invoke(nextSet, "add", property);
    JsValue incoming = next[property];
    JsValue previous = state[property];
    if (shouldRecurse(previous, incoming, key, parentMeta, property)) {
      reconcileInto(incoming, previous, key, false);
    }
    else writeKey(state, property, incoming);
  }
  JsValue oldKeys = mergedOwnKeys(state[$TARGET_VALUE]);
  for (int index = 0; index < lengthOf(oldKeys); index++) {
    JsValue property = oldKeys[index];
    if (isUnsafeKey(property)) continue;
    if (isEnumerable(state, property) && !JS.invoke(nextSet, "has", property).truthy()) deleteKey(state, property);
  }
}

export void reconcileInto(JsValue next, JsValue state, JsValue key, bool replace) {
  if (!isWrappableKernel(next) || !isWrappableKernel(state)) return;
  if (JS.isArray(next) != JS.isArray(state)) return;
