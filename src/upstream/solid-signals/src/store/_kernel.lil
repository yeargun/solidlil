JsValue mergedOwnKeysMode(JsValue meta, bool tracked) {
  guardProjectionRead(meta);
  ensureProjection(meta);
  if (tracked) trackSelf(meta);
  JsValue result = JS.array();
  JsValue seen = JS.construct(Set);
  JsValue base = ownKeys(meta["source"]);
  if (meta["source"][$TARGET_VALUE].truthy()) {
    JsValue source = meta["source"];
    base = hostUntrack(
      JS.method0((JsValue _self) => ownKeys(source)),
      undef()
    );
  }
  JsValue overlay = ownKeys(meta["overlays"]);
  int arrayLength = -1;
  if (JS.isArray(meta["source"])) {
    arrayLength = JS.number(sourceValue(meta, "length")).toInt();
    if (meta["optimistic"].truthy()) arrayLength = JS.number(currentValue(meta, "length", false)).toInt();
  }
  for (int index = 0; index < lengthOf(base); index++) {
    JsValue key = base[index];
    JS.invoke(seen, "add", key);
    bool include = sourceHas(meta, key);
    if (meta["optimistic"].truthy()) include = currentHas(meta, key, false);
    if (arrayLength >= 0 && isArrayIndex(key) && JS.number(key).toInt() >= arrayLength) include = false;
    if (include) JS.invoke(result, "push", key);
  }
  for (int index = 0; index < lengthOf(overlay); index++) {
    JsValue key = overlay[index];
    if (JS.invoke(seen, "has", key).truthy()) continue;
    JS.invoke(seen, "add", key);
    bool include = sourceHas(meta, key);
    if (meta["optimistic"].truthy()) include = currentHas(meta, key, false);
    if (arrayLength >= 0 && isArrayIndex(key) && JS.number(key).toInt() >= arrayLength) include = false;
    if (include) JS.invoke(result, "push", key);
  }
  if (JS.isArray(meta["source"]) && !JS.invoke(seen, "has", "length").truthy()) {
    JS.invoke(result, "push", "length");
