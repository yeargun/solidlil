    return true;
  });
  handler["deleteProperty"] = JS.method2((JsValue _self, JsValue _actual, JsValue key) => {
    if (writeDepth > 0) stageValue(meta, key, undef(), true);
    return true;
  });
  handler["defineProperty"] = JS.method3((JsValue _self, JsValue _actual, JsValue key, JsValue desc) => {
    if (writeDepth > 0) stageDescriptor(meta, key, desc);
