    if (JS.strictEqual(key, $TARGET_VALUE) || JS.strictEqual(key, $PROXY_VALUE) ||
        JS.strictEqual(key, $TRACK_VALUE) || JS.strictEqual(key, "__proto__")) return true;
    return currentHas(meta, key, true);
  });
  handler["set"] = JS.method3((JsValue _self, JsValue _actual, JsValue key, JsValue value) => {
    if (writeDepth > 0) {
      if (JS.isArray(meta["source"]) && JS.strictEqual(key, "length")) {
        stageArrayLength(meta, JS.number(value).toInt());
      } else stageValue(meta, key, value, false);
