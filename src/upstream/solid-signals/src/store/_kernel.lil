JsValue makeHandler(JsValue meta) {
  JsValue handler = JS.object();
  JsValue refreshKey = JS.assume($REFRESH);
  handler["get"] = JS.method3((JsValue _self, JsValue _actual, JsValue key, JsValue receiver) => {
    if (JS.strictEqual(key, $TARGET_VALUE)) return meta;
    if (JS.strictEqual(key, $PROXY_VALUE)) return receiver;
    if (JS.strictEqual(key, refreshKey)) return meta["refresh"];
    if (JS.strictEqual(key, $TRACK_VALUE)) {
      trackSelf(meta);
      return receiver;
    }
    JsValue desc = undef();
    if (meta["source"][$TARGET_VALUE].truthy()) {
      JsValue property = key;
      desc = hostUntrack(
        JS.method0((JsValue _untrackSelf) => sourceOwnDescriptor(meta, property)),
        undef()
      );
    } else desc = sourceOwnDescriptor(meta, key);
    if (desc.truthy() && desc["get"].truthy()) return JS.call(desc["get"], receiver);
    JsValue current = getPrototype(meta["source"]);
    while (current.truthy() && !JS.strictEqual(current, Object["prototype"])) {
