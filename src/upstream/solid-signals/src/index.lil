import { affects } from "./affects";
import {
  createErrorBoundary,
  createLoadingBoundary,
  createRevealOrder,
  flatten
} from "./boundaries";
import {
  $REFRESH,
  ContextNotFoundError,
  DEV,
  NoOwnerError,
  NotReadyError,
  SUPPORTS_PROXY,
  action,
  clearSnapshots,
  createContext,
  createOwner,
  createRoot,
  enableExternalSource,
  enforceLoadingBoundary,
  flush,
  getContext,
  getNextChildId,
  getObserver,
  getOwner,
  isDisposed,
  isEqual,
  isPending,
  latest,
  markSnapshotScope,
  peekNextChildId,
  releaseSnapshotScope,
  resetErrorHalt,
  runWithOwner,
  setContext,
  setSnapshotCapture,
  untrack as coreUntrack
} from "./core/index";
import { refresh as coreRefresh } from "./core/core";
import { mapArray, repeat } from "./map";
import {
  accessor,
  createEffect,
  createMemo,
  createOptimistic,
  createReaction,
  createRenderEffect,
  createSignal,
  createTrackedEffect,
  onCleanup,
  onSettled,
  resolve as signalResolve
} from "./signals";
import {
  $PROXY,
  $TARGET,
  $TRACK,
  createOptimisticStore,
  createProjection,
  createStore,
  deep,
  isWrappable,
  merge,
  omit,
  reconcile,
  snapshot,
  storePath
} from "./store/index";

export {
  $PROXY,
  $REFRESH,
  $TARGET,
  $TRACK,
  ContextNotFoundError,
  DEV,
  NoOwnerError,
  NotReadyError,
  SUPPORTS_PROXY,
  action,
  affects,
  clearSnapshots,
  createContext,
  createEffect,
  createErrorBoundary,
  createLoadingBoundary,
  createMemo,
  createOptimistic,
  createOptimisticStore,
  createOwner,
  createProjection,
  createReaction,
  createRenderEffect,
  createRevealOrder,
  createRoot,
  createSignal,
  createStore,
  createTrackedEffect,
  deep,
  enableExternalSource,
  enforceLoadingBoundary,
  flatten,
  flush,
  getContext,
  getNextChildId,
  getObserver,
  getOwner,
  isDisposed,
  isEqual,
  isPending,
  isWrappable,
  latest,
  mapArray,
  markSnapshotScope,
  merge,
  omit,
  onCleanup,
  onSettled,
  peekNextChildId,
  reconcile,
  releaseSnapshotScope,
  repeat,
  resetErrorHalt,
  runWithOwner,
  setContext,
  setSnapshotCapture,
  snapshot,
  storePath
};

export void refresh(JsValue value) {
  coreRefresh(value);
}

export JsValue resolve(JsValue callback) {
  return signalResolve(callback);
}

export JsValue untrack(JsValue callback, JsValue strictReadLabel) {
  return coreUntrack(callback, strictReadLabel);
}
